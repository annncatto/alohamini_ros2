<?xml version="1.0"?>
<package format="3">
  <name>alohamini_bringup</name>
  <version>0.1.0</version>
  <description>Single-owner ROS 2 hardware composition for AlohaMini.</description>
  <maintainer email="anncatto@users.noreply.github.com">anncatto</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>alohamini_camera</exec_depend>
  <exec_depend>alohamini_description</exec_depend>
  <exec_depend>alohamini_joycon_teleop</exec_depend>
  <exec_depend>alohamini_lerobot_bridge</exec_depend>
  <exec_depend>alohamini_moveit_config</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
