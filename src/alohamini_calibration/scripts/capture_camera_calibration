#!/usr/bin/env python3
"""Capture unique JPEG frames directly from the Host camera-only stream."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

import cv2
import numpy as np
import yaml
import zmq


def parse_message(parts: list[bytes], expected_camera: str) -> tuple[dict, bytes]:
    if len(parts) != 3 or parts[0] != f"camera/{expected_camera}".encode():
        raise ValueError("unexpected Host camera multipart message")
    metadata = json.loads(parts[1].decode("utf-8"))
    if (
        not isinstance(metadata, dict)
        or metadata.get("schema_version") != 1
        or metadata.get("camera_name") != expected_camera
        or metadata.get("encoding") != "jpeg"
    ):
        raise ValueError("invalid Host camera metadata")
    if not parts[2].startswith(b"\xff\xd8"):
        raise ValueError("Host camera payload is not JPEG")
    return metadata, parts[2]


def show_preview(
    window_name: str,
    jpeg: bytes,
    camera: str,
    captured: int,
    requested: int,
) -> bool:
    """Show one JPEG frame; return False when the operator requests exit."""
    frame = cv2.imdecode(np.frombuffer(jpeg, dtype=np.uint8), cv2.IMREAD_COLOR)
    if frame is None:
        raise ValueError("OpenCV could not decode Host camera JPEG")
    cv2.putText(
        frame,
        f"{camera}  saved {captured}/{requested}  [Q/ESC: finish]",
        (16, 32),
        cv2.FONT_HERSHEY_SIMPLEX,
        0.7,
        (0, 255, 0),
        2,
        cv2.LINE_AA,
    )
    cv2.imshow(window_name, frame)
    key = cv2.waitKey(1) & 0xFF
    return key not in (ord("q"), ord("Q"), 27)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--host", required=True)
    parser.add_argument("--port", type=int, default=5557)
    parser.add_argument("--camera", required=True)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--count", type=int, default=40)
    parser.add_argument("--min-interval-sec", type=float, default=0.20)
    parser.add_argument("--timeout-sec", type=float, default=5.0)
    parser.add_argument(
        "--no-preview",
        action="store_true",
        help="disable the OpenCV window (for headless capture)",
    )
    args = parser.parse_args()
    if args.count < 1 or args.min_interval_sec < 0.0 or args.timeout_sec <= 0.0:
        raise ValueError("count and timeout must be positive; interval cannot be negative")

    args.output.mkdir(parents=True, exist_ok=True)
    context = zmq.Context()
    socket = context.socket(zmq.SUB)
    socket.setsockopt(zmq.LINGER, 0)
    socket.setsockopt(zmq.SUBSCRIBE, f"camera/{args.camera}".encode())
    socket.connect(f"tcp://{args.host}:{args.port}")
    samples = []
    last_saved = 0.0
    deadline = time.monotonic() + args.timeout_sec
    preview_enabled = not args.no_preview
    window_name = f"AlohaMini intrinsic capture: {args.camera}"
    if preview_enabled and not (
        os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")
    ):
        raise RuntimeError(
            "preview requested but no graphical display is available; "
            "run on the desktop or pass --no-preview"
        )
    if preview_enabled:
        cv2.namedWindow(window_name, cv2.WINDOW_NORMAL | cv2.WINDOW_KEEPRATIO)
        cv2.resizeWindow(window_name, 960, 540)
    try:
        while len(samples) < args.count:
            if not socket.poll(100, zmq.POLLIN):
                if time.monotonic() >= deadline:
                    raise TimeoutError("timed out waiting for Host camera stream")
                continue
            metadata, jpeg = parse_message(socket.recv_multipart(), args.camera)
            deadline = time.monotonic() + args.timeout_sec
            now = time.monotonic()
            if now - last_saved >= args.min_interval_sec:
                index = len(samples)
                filename = f"{args.camera}_{index:04d}.jpg"
                path = args.output / filename
                path.write_bytes(jpeg)
                samples.append(
                    {
                        "file": filename,
                        "sequence": int(metadata["sequence"]),
                        "capture_monotonic_s": float(metadata["capture_monotonic_s"]),
                        "capture_unix_ns": int(metadata["capture_unix_ns"]),
                        "sha256": hashlib.sha256(jpeg).hexdigest(),
                    }
                )
                last_saved = now
                print(
                    f"[{len(samples):03d}/{args.count:03d}] {filename}",
                    file=sys.stderr,
                )
            if preview_enabled and not show_preview(
                window_name, jpeg, args.camera, len(samples), args.count
            ):
                print("Capture finished by operator.", file=sys.stderr)
                break
    finally:
        if preview_enabled:
            cv2.destroyWindow(window_name)
        socket.close(linger=0)
        context.term()

    manifest = {
        "schema_version": 1,
        "status": "raw_capture",
        "captured_at": datetime.now(timezone.utc).isoformat(),
        "camera_name": args.camera,
        "requested_samples": args.count,
        "captured_samples": len(samples),
        "source": {
            "transport": "alohamini_host_camera_stream_v1",
            "host": args.host,
            "port": args.port,
        },
        "samples": samples,
    }
    (args.output / "manifest.yaml").write_text(
        yaml.safe_dump(manifest, sort_keys=False), encoding="utf-8"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
